# External Server mode: copy to .env.demo (mode 600), then ./start.sh --external.
# Use a separate Compose project for each installation. Only demo-lab is created.
PB_DEMO_MODE=external
PB_DEMO_SERVER_URL=https://plantbot.example.com/robots
PB_DEMO_ADMIN_USER=admin
PB_ADMIN_PASSWORD=
# Address the Server can reach; this is the demo machine, not the Server.
PB_DEMO_RTSP_BASE=rtsp://192.168.1.100:18554
PB_DEMO_RTSP_BIND=0.0.0.0
PB_DEMO_RTSP_PORT=18554
